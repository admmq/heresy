diff --git a/client/cmake/Modules/Findlibssh.cmake b/client/cmake/Modules/Findlibssh.cmake
new file mode 100644
index 0000000..0d33f59
--- /dev/null
+++ b/client/cmake/Modules/Findlibssh.cmake
@@ -0,0 +1,22 @@
+# Locate Guix's libssh package and expose it under the imported
+# target name ssh::ssh, which is what upstream amnezia-client expects
+# (matching the Conan libssh recipe's exported target).  Guix's own
+# libssh-config.cmake (installed by libssh itself) only defines a bare
+# "ssh" target with no "ssh::ssh" alias, so CMake's normal Config-mode
+# lookup for find_package(libssh) is not enough; this Find module
+# (picked up first, since Module mode is tried before Config mode) does
+# the location/target setup directly instead.
+
+find_path(LIBSSH_INCLUDE_DIR NAMES libssh/libssh.h)
+find_library(LIBSSH_LIBRARY NAMES ssh)
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(libssh
+  REQUIRED_VARS LIBSSH_LIBRARY LIBSSH_INCLUDE_DIR)
+
+if(libssh_FOUND AND NOT TARGET ssh::ssh)
+  add_library(ssh::ssh UNKNOWN IMPORTED)
+  set_target_properties(ssh::ssh PROPERTIES
+    IMPORTED_LOCATION "${LIBSSH_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${LIBSSH_INCLUDE_DIR}")
+endif()
