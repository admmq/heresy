Amnezia's own CMake build doesn't use plain find_package() 
the normal way. Their top-level CMakeLists.txt hooks in Conan, 
which intercepts every find_package() call in the whole project.
For OpenVPN, AmneziaWG, libssh, tun2socks, the Xray bindings 
and the GeoIP/domain data files, Conan would download prebuilt 
binaries from Amnezia's own package server to link against.
This adds CMake Find modules to replace the Conan-based
dependency discovery.

diff --git a/client/cmake/Modules/Findamnezia-xray-bindings.cmake b/client/cmake/Modules/Findamnezia-xray-bindings.cmake
new file mode 100644
index 0000000..ffbbb25
--- /dev/null
+++ b/client/cmake/Modules/Findamnezia-xray-bindings.cmake
@@ -0,0 +1,21 @@
+# Locate the Xray-core C static library and header, replacing the
+# Conan "amnezia-xray-bindings" recipe used by upstream amnezia-client.
+# Defines the imported target amnezia::xray-bindings.
+
+find_path(AMNEZIA_XRAY_INCLUDE_DIR NAMES amnezia_xray.h)
+find_library(AMNEZIA_XRAY_LIBRARY NAMES amnezia_xray)
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(amnezia-xray-bindings
+  REQUIRED_VARS AMNEZIA_XRAY_LIBRARY AMNEZIA_XRAY_INCLUDE_DIR)
+
+if(amnezia-xray-bindings_FOUND AND NOT TARGET amnezia::xray-bindings)
+  add_library(amnezia::xray-bindings STATIC IMPORTED)
+  set_target_properties(amnezia::xray-bindings PROPERTIES
+    IMPORTED_LOCATION "${AMNEZIA_XRAY_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${AMNEZIA_XRAY_INCLUDE_DIR}")
+  # The Xray-core Go runtime needs to resolve its own symbols and talk to
+  # the platform thread/network APIs when linked into a C/C++ binary.
+  set_property(TARGET amnezia::xray-bindings PROPERTY
+    INTERFACE_LINK_LIBRARIES pthread)
+endif()
