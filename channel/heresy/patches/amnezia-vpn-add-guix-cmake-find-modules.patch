diff --git a/client/cmake/Modules/Findv2ray-rules-dat.cmake b/client/cmake/Modules/Findv2ray-rules-dat.cmake
new file mode 100644
index 0000000..ee7f913
--- /dev/null
+++ b/client/cmake/Modules/Findv2ray-rules-dat.cmake
@@ -0,0 +1,12 @@
+# Locate the geoip.dat/geosite.dat Xray routing rule data files,
+# replacing the Conan "v2ray-rules-dat" recipe used by upstream
+# amnezia-client.  Does not define an imported target; sets
+# GEOIP_DAT_PATH/GEOSITE_DAT_PATH, as the Conan recipe's
+# cmake_extra_variables did.
+
+find_file(GEOIP_DAT_PATH NAMES geoip.dat PATH_SUFFIXES share/v2ray-rules-dat)
+find_file(GEOSITE_DAT_PATH NAMES geosite.dat PATH_SUFFIXES share/v2ray-rules-dat)
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(v2ray-rules-dat
+  REQUIRED_VARS GEOIP_DAT_PATH GEOSITE_DAT_PATH)
